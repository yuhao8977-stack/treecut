# ============================================================
# 树剪 (TreeCut) v11.1 — 环境变量配置模板
# ============================================================
# v11.1 — 使用方法:
#   1. 复制此文件为 .env :  copy .env.example .env
#   2. 按需编辑 .env 填入真实值（留空使用默认值）
#   3. .env 文件已在 .gitignore 中排除，不会被提交到 Git
# ============================================================

# ── API 密钥 ────────────────────────────────────────────
# DeepSeek API Key（必填 — AI 文案生成依赖此服务）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Pixabay API Key（可选 — BGM 免费音乐自动下载）
# 获取地址: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── 素材路径（留空使用 Z: 盘 默认值） ──────────────────
# 卖点展示类素材目录
# TREECUT_SELLING_DIR=Z:\已处理素材\卖点展示类素材

# 效果展示类素材目录
# TREECUT_EFFECTS_DIR=Z:\已处理素材\效果展示类素材

# B 组补充素材目录
# TREECUT_BGROUP_DIR=Z:\B组更新视频

# 视频脚本文件夹
# TREECUT_SCRIPT_DIR=Z:\视频脚本文件夹

# ── 输出路径（留空使用项目相对目录） ────────────────────
# TREECUT_DRAFT_DIR=03_粗剪输出
# TREECUT_COPY_DIR=04_文案
# TREECUT_TTS_DIR=05_配音
# TREECUT_BGM_DIR=02_BGM
# TREECUT_VOICE_DIR=custom_voice/model

# ── Web 控制台 ──────────────────────────────────────────
# Gradio Web UI 端口号（默认 7860，设 0 禁用 Web UI）
TREECUT_WEB_PORT=7860

# Web 访问令牌（留空则不启用认证，建议生产环境设置）
# TREECUT_WEB_TOKEN=

# ── AI 视觉模型 ─────────────────────────────────────────
# 视觉模型 (v11.1: 仅支持 qwen3-4b 本地模型，无降级)
TREECUT_VISION_MODEL=qwen3-4b

# 高级标注流水线（启用多模型并行分析+自动标签融合）
TREECUT_ADVANCED_ANNOTATION=true

# 向量检索后端: faiss / chroma
TREECUT_VECTOR_BACKEND=faiss

# ── 素材质量过滤 ────────────────────────────────────────
# 启用素材质量过滤（自动排除低质量素材）
# TREECUT_ENABLE_QUALITY_FILTER=true

# ── 脚本去重配置 (v11.1 新增) ────────────────────────
# 批量生成时排除最近使用的脚本数 (0=不排除)
TREECUT_EXCLUDE_RECENT_SCRIPTS=5

# 优先使用使用次数少的素材（提升多样性）
TREECUT_USE_FRESH_MATERIALS=true
# TREECUT_QUALITY_MIN_SCORE=0.3

# 启用重复素材去重
# TREECUT_ENABLE_DEDUPLICATION=true

# 去重汉明距离阈值（默认 5）
# TREECUT_DEDUPLICATION_HAMMING_DIST=5
